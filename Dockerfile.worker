# Background worker image (WhatsApp reminders, dispatch, connection health).
# Node >= 22.18 runs the TypeScript sources directly (type stripping only).
FROM node:22-bookworm-slim
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile
COPY lib/messaging ./lib/messaging
COPY lib/telemetry/logger.ts ./lib/telemetry/logger.ts
COPY worker ./worker
ENV NODE_ENV=production
USER node
CMD ["node", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "worker/index.ts"]
