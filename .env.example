# Copy to .env.local. Values for local development come from `pnpm exec supabase status`.
# Never commit real values. Never prefix a secret with NEXT_PUBLIC_.

# Browser-safe Supabase settings (RLS protects all data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database tests (pnpm test:db): superuser connection to a disposable PostgreSQL server.
TEST_DB_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
