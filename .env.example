# Copy to .env.local for local development. NEVER commit real values.
# All values below are placeholders.

# Deployment environment: development | test | staging | production
APP_ENV=development

# ADR-0005: synthetic UI preview at /<locale>/preview. Refused when APP_ENV=production.
UI_PREVIEW_ENABLED=true

# Supabase (from `npx supabase status` for local, or the project settings).
# The publishable key is public by design and protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets are NOT used in Milestone 0. When added (e.g.
# SUPABASE_SECRET_KEY), they must never use the NEXT_PUBLIC_ prefix and must
# only be read from server-only modules (lib/env/server.ts).

# Database tests (tests/db): a DISPOSABLE PostgreSQL server; tests create and
# drop their own databases. Never point this at a shared or production server.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
